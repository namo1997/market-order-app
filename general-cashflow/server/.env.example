CASHFLOW_PORT=8100
CASHFLOW_HOST=0.0.0.0
CASHFLOW_CORS_ORIGIN=http://localhost:5178,http://127.0.0.1:5178

# Dedicated MySQL database for this standalone app
CASHFLOW_DB_HOST=localhost
CASHFLOW_DB_PORT=3306
CASHFLOW_DB_USER=root
CASHFLOW_DB_PASSWORD=
CASHFLOW_DB_NAME=general_cashflow_db
CASHFLOW_DB_CONNECTION_LIMIT=10

CASHFLOW_JWT_SECRET=change-this-cashflow-secret
CASHFLOW_JWT_EXPIRES_IN=12h
# Sign in with Google is enabled only when both values below are set.
# The client ID is public; the email allowlist is enforced again on the server.
CASHFLOW_GOOGLE_CLIENT_ID=
CASHFLOW_GOOGLE_ALLOWED_EMAILS=
# Google login adopts this existing app user's permissions without creating or linking a user row.
CASHFLOW_GOOGLE_APP_USERNAME=admin
CASHFLOW_SHEETS_EXPORT_TOKEN=change-this-readonly-sheets-token
CASHFLOW_ACCOUNTING_EXPORT_TOKEN=change-this-readonly-accounting-token
# Used only by the Google Apps Script that imports Krungsri report ZIP files.
CASHFLOW_GMAIL_INBOX_TOKEN=change-this-long-random-secret
# Passwords are server-only. When a bank ZIP contains protected PDFs, General
# Cashflow unlocks the evidence before saving it so reviewers can open it directly.
CASHFLOW_SCB_ZIP_PASSWORD=
CASHFLOW_KRUNGTHAI_ZIP_PASSWORD=
CASHFLOW_QPDF_PATH=qpdf
CASHFLOW_ADMIN_USERNAME=admin
CASHFLOW_ADMIN_PASSWORD=change-me-now
CASHFLOW_SEED_DEMO_USERS=true

# Read-only POS source. Kept as its own CASHFLOW_-prefixed copy on purpose —
# this app must never depend on the market-order app's env vars or .env file,
# even for values that happen to point at the same POS backend.
CASHFLOW_CLICKHOUSE_HOST=
CASHFLOW_CLICKHOUSE_PORT=8123
CASHFLOW_CLICKHOUSE_USER=
CASHFLOW_CLICKHOUSE_PASSWORD=
CASHFLOW_CLICKHOUSE_DATABASE=dedebi
CASHFLOW_CLICKHOUSE_SECURE=false
CASHFLOW_CLICKHOUSE_SHOP_ID=2OJMVIo1Qi81NqYos3oDPoASziy
CASHFLOW_CLICKHOUSE_TZ_OFFSET=7

CASHFLOW_UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# AI agents (อ่านอย่างเดียวทั้งหมด — ไม่มีตัวไหนเขียนยอดเงินหรือเปลี่ยนสถานะเอกสาร)
#
# ปล่อย API key ว่างไว้ = ปิด AI ระบบยังทำงานปกติทุกอย่าง
# สรุปตอนเช้าจะตกไปใช้ข้อความ deterministic ที่สร้างจาก SQL ล้วน
#
# แยก key ต่อ agent เพื่อให้ตั้ง spending limit และดู usage แยกกันได้
# ถ้าตัวใดตัวหนึ่งรั่วก็เพิกถอนเฉพาะตัวนั้น ไม่ล้มทั้งระบบ
# ห้าม commit ค่าจริงลง git — ไฟล์ .env ถูก .gitignore ไว้แล้ว
# ---------------------------------------------------------------------------

# Agent #3 — สรุปงานค้างตอนเช้า
CASHFLOW_BRIEF_API_KEY=
CASHFLOW_BRIEF_MODEL=gpt-5.6-luna
CASHFLOW_BRIEF_REASONING_EFFORT=medium
CASHFLOW_BRIEF_MAX_OUTPUT_TOKENS=8000

# Agent #1 — เสนอการจับคู่เงินเข้า (อ่านอย่างเดียวจนกว่าคนจะกดยืนยัน)
CASHFLOW_MATCH_API_KEY=
CASHFLOW_MATCH_MODEL=gpt-5.6-terra
CASHFLOW_MATCH_REASONING_EFFORT=high
CASHFLOW_MATCH_MAX_OUTPUT_TOKENS=16000

# Agent #2 — คัดประเภทไฟล์ธนาคาร และยกระดับไป terra เมื่อ sanity check ไม่ผ่าน
CASHFLOW_BANK_FILE_API_KEY=
CASHFLOW_BANK_FILE_MODEL=gpt-5.6-luna
CASHFLOW_BANK_FILE_ESCALATION_MODEL=gpt-5.6-terra
CASHFLOW_BANK_FILE_REASONING_EFFORT=medium
CASHFLOW_BANK_FILE_MAX_OUTPUT_TOKENS=8000

# อ่านรูปสรุปแคชเชียร์ — ใช้ CASHFLOW_MATCH_API_KEY ร่วมกับ Agent #1
CASHFLOW_CASHIER_IMAGE_MODEL=gpt-5.6-terra
CASHFLOW_CASHIER_IMAGE_REASONING_EFFORT=medium
CASHFLOW_CASHIER_IMAGE_DETAIL=high

# ใช้เป็น key กลางเมื่อไม่ได้ตั้งแยกราย agent
CASHFLOW_OPENAI_API_KEY=
CASHFLOW_OPENAI_BASE_URL=https://api.openai.com/v1
CASHFLOW_OPENAI_TIMEOUT_MS=120000
# ลองใหม่เฉพาะ network error / 429 / 5xx — key ผิดหรือ request ผิดจะไม่ลองซ้ำ
CASHFLOW_OPENAI_MAX_RETRIES=2
CASHFLOW_OPENAI_RETRY_BASE_MS=1000

# ร่องรอยการทำงานของ agent (JSONL วันละไฟล์) ตั้ง 0 เพื่อปิด
CASHFLOW_AGENT_TRACE_ENABLED=1
CASHFLOW_AGENT_TRACE_DIR=

# Hidden pre-decision reviewer. It can write only decision/shadow audit tables.
# Browser mutations require a human reason by default; set 0 only in isolated tests.
CASHFLOW_SHADOW_API_KEY=
CASHFLOW_SHADOW_MODEL=gpt-5.4-mini
CASHFLOW_SHADOW_REASONING_EFFORT=low
CASHFLOW_SHADOW_MAX_OUTPUT_TOKENS=2200
CASHFLOW_DECISION_REASON_REQUIRED=1
# Local preview leaves every AI key empty unless this is explicitly set to 1.
CASHFLOW_PREVIEW_AI_ENABLED=0

# เวลาสร้างสรุปตอนเช้าอัตโนมัติ (เวลาไทย) ปล่อยว่างหรือ off = ไม่ตั้งเวลา
CASHFLOW_BRIEF_SCHEDULE_HHMM=07:00
