PORT=8000
HOST=0.0.0.0

# LINE Messaging API channel for this capture service only.
# Do not commit real values. Rotate any token/secret that was shared in chat.
LINE_BILL_CAPTURE_CHANNEL_ACCESS_TOKEN=
LINE_BILL_CAPTURE_ACCOUNTING_EXPORT_TOKEN=
LINE_BILL_CAPTURE_CHANNEL_SECRET=
# 1 blocks every outbound LINE push while keeping webhook capture and media downloads active.
LINE_BILL_CAPTURE_SILENT_MODE=0
# JSON map keyed by LINE group source_id, for stable names in the admin UI.
LINE_BILL_CAPTURE_GROUP_LABELS={}
# JSON map of groups allowed to receive a result after the exact command "ตรวจบิล".
# Example: {"C123":{"mode":"bill_summary","supplier":"เจ๊แววไก่สด","reply_enabled":true}}
LINE_BILL_CAPTURE_VALIDATION_GROUPS={}

# Local/Railway persistent storage. Mount a Railway volume at /data in production.
CAPTURE_DATA_DIR=./data
# A failed LINE media fetch remains retryable by the recovery loop up to this many cycles.
LINE_BILL_CAPTURE_DOWNLOAD_MAX_ATTEMPTS=5
# Public HTTPS origin used by LINE to fetch the bill image attached to an explicit transfer request.
# Railway example: https://line-bill-capture-production.up.railway.app
LINE_BILL_CAPTURE_PUBLIC_BASE_URL=

# AI OCR / vision worker. Leave OPENAI_API_KEY empty to keep AI disabled.
AI_WORKER_ENABLED=auto
# Local preview keeps AI off unless this is explicitly enabled.
PREVIEW_AI_ENABLED=0
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_IMAGE_DETAIL=high
OPENAI_MAX_OUTPUT_TOKENS=3000
# Hidden pre-decision reviewer. It is disabled unless this separate key is set.
SHADOW_AI_API_KEY=
SHADOW_AI_MODEL=gpt-5.4-mini
SHADOW_AI_REASONING_EFFORT=low
SHADOW_AI_TIMEOUT_MS=45000
# Local preview sets this to 1 unless PREVIEW_AI_ENABLED=1.
SHADOW_AI_DISABLED=0
# Keep enabled in production. Tests may set 0 explicitly.
DECISION_REASON_REQUIRED=1
# Cost estimate shown in the admin header. Override token rates if pricing changes.
AI_COST_USD_THB_RATE=35
AI_INPUT_USD_PER_MILLION=2.5
AI_CACHED_INPUT_USD_PER_MILLION=0.25
AI_OUTPUT_USD_PER_MILLION=15
AI_WORKER_INTERVAL_MS=15000
AI_WORKER_START_DELAY_MS=2000
AI_WORKER_BATCH_SIZE=5
AI_WORKER_MAX_ATTEMPTS=8
AI_WORKER_STALE_PROCESSING_MS=30000
AI_AUTO_MATCH_ENABLED=true
AI_AUTO_MATCH_MIN_SCORE=90
AI_SEQUENCE_MATCH_MIN_SCORE=50
AI_MATCH_REQUIRE_SAME_SOURCE=true
# JSON map: slip group -> bill groups searched only as a fallback.
# Default code fallback searches Khlong bills when a Sankamphaeng slip has no local candidate.
# Override with a complete JSON map when group routing changes.
AI_MATCH_SOURCE_FALLBACKS={"C987d13b96371f18f5a0996107d4f6ef5":["C92c8a7b4a5099db619f6464e10eefab5"]}

# Optional canonical identities for imported LINE exports: {"display name":"real LINE user id"}.
LINE_EXPORT_SENDER_ALIASES={}
AI_MATCH_AMOUNT_TOLERANCE=5
AI_MATCH_PERCENT_TOLERANCE=0.02
AI_MATCH_MAX_HOURS=48

# --- Admin access (required in production) ---
# Recommended: set a random value of at least 24 characters in Railway Variables, then open
# /admin?access=<ADMIN_ACCESS_TOKEN> once. The server stores a signed session and redirects to
# the clean /admin URL, so there is no password form in normal use. Never commit the real value.
ADMIN_ACCESS_TOKEN=
# Optional card selector after shared-link authentication. This identifies who reviewed/edited;
# all selected operators still use the same shared access permission.
ADMIN_OPERATOR_NAMES=[]
# Optional fallback login form. Leave empty when using the private access link only.
ADMIN_PIN=
# Local preview sets this automatically while bound to 127.0.0.1. It is deliberately ignored on
# non-loopback hosts, so setting it on Railway cannot accidentally expose production.
ADMIN_AUTH_DISABLED=0
# Optional: persist sessions across restarts (otherwise a random key is generated each boot,
# which simply means the private link must be opened again after a redeploy).
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=720
ADMIN_MAX_FAILS=5
ADMIN_LOCK_MINUTES=15
