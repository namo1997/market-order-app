PORT=8000
HOST=0.0.0.0

# LINE Messaging API channel for this capture service only.
# Do not commit real values. Rotate any token/secret that was shared in chat.
LINE_BILL_CAPTURE_CHANNEL_ACCESS_TOKEN=
LINE_BILL_CAPTURE_CHANNEL_SECRET=
# JSON map keyed by LINE group source_id, for stable names in the admin UI.
LINE_BILL_CAPTURE_GROUP_LABELS={}
# JSON map of groups allowed to receive a result after the exact command "ตรวจบิล".
# Example: {"C123":{"mode":"bill_summary","supplier":"เจ๊แววไก่สด","reply_enabled":true}}
LINE_BILL_CAPTURE_VALIDATION_GROUPS={}

# Local/Railway persistent storage. Mount a Railway volume at /data in production.
CAPTURE_DATA_DIR=./data

# AI OCR / vision worker. Leave OPENAI_API_KEY empty to keep AI disabled.
AI_WORKER_ENABLED=auto
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_IMAGE_DETAIL=high
OPENAI_MAX_OUTPUT_TOKENS=3000
AI_WORKER_INTERVAL_MS=15000
AI_WORKER_START_DELAY_MS=2000
AI_WORKER_BATCH_SIZE=5
AI_WORKER_MAX_ATTEMPTS=3
AI_WORKER_STALE_PROCESSING_MS=30000
AI_AUTO_MATCH_ENABLED=true
AI_AUTO_MATCH_MIN_SCORE=90
AI_SEQUENCE_MATCH_MIN_SCORE=50
AI_MATCH_REQUIRE_SAME_SOURCE=true
# JSON map: slip group -> bill groups searched only as a fallback.
AI_MATCH_SOURCE_FALLBACKS={}
AI_MATCH_AMOUNT_TOLERANCE=5
AI_MATCH_PERCENT_TOLERANCE=0.02
AI_MATCH_MAX_HOURS=48

# --- Admin PIN auth (required in production) ---
# /admin and /api/admin are locked until ADMIN_PIN is set. Set it in Railway Variables.
# NEVER commit a real PIN. A short PIN is safe only because logins are rate limited below.
ADMIN_PIN=
# Optional: persist sessions across restarts (otherwise a random key is generated each boot,
# which simply means everyone re-enters the PIN after a redeploy).
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=720
ADMIN_MAX_FAILS=5
ADMIN_LOCK_MINUTES=15
