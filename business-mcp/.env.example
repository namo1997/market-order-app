# Set these in a secret store. Never commit real values.
BUSINESS_MCP_CLIENTS_JSON=[{"name":"owner","token_sha256":"<sha256-of-long-random-token>","branches":["KK","SK"],"min_date":"2026-01-01","max_date":"2026-12-31","allow_hr_operations":false,"allow_hr_leave_reasons":false,"allow_person_details":false,"employee_ids":[]}]
BUSINESS_BRANCH_MAP_JSON=[{"code":"KK","market_order_id":1,"hrms_id":"BR02","cashflow_code":"KK","line_source_id":"C92c8a7b4a5099db619f6464e10eefab5"},{"code":"SK","market_order_id":3,"hrms_id":"BR03","cashflow_code":"SK","line_source_id":"C987d13b96371f18f5a0996107d4f6ef5"}]
MARKET_ORDER_BASE_URL=https://<market-order-host>
HRMS_MCP_URL=https://<hrms-host>/mcp
HRMS_MCP_TOKENS_JSON={"KK":"<HRMS-scoped-token-for-KK>","SK":"<HRMS-scoped-token-for-SK>"}
CASHFLOW_BASE_URL=https://<cashflow-host>
CASHFLOW_DOT_BEARER=
LINE_BILL_BASE_URL=https://<line-bill-host>
LINE_BILL_EXPORT_BEARER=
PORT=3000
# OAuth for ChatGPT custom MCP (single owner, DCR + authorization code + PKCE).
BUSINESS_PUBLIC_URL=https://<gateway-domain>
BUSINESS_OAUTH_SIGNING_KEY=<base64url-encoded-32-plus-random-bytes>
BUSINESS_OAUTH_PASSWORD_SHA256=<sha256-of-strong-owner-login-secret>
BUSINESS_OAUTH_CLIENT_NAME=owner

# Optional POS detail candidate; keep closed until read-only grants/schema/branch proof.
# Use sealed runtime secret bindings, not values in this file.
# BUSINESS_POS_CLICKHOUSE_URL=https://<reviewed-existing-origin>:<tls-port>/
# BUSINESS_POS_CLICKHOUSE_DATABASE=<reviewed-database>
# BUSINESS_POS_SHOP_ID=<reviewed-shop-id>
# BUSINESS_POS_CLICKHOUSE_USER=<purpose-specific-reader>
# BUSINESS_POS_CLICKHOUSE_PASSWORD=<sealed-reference>
# BUSINESS_POS_CURSOR_KEY=<gateway-only-random-secret-at-least-32-chars>
# BUSINESS_POS_CLASSIFICATION_JSON=[]
# Extend authorized existing client policy with allow_pos_details:true,
# and verified branch records with clickhouse_branch_id; preserve other fields.

# Optional temporary operator-only chat diagnostic; independent of POS data access.
# BUSINESS_POS_METADATA_ENABLED=false
